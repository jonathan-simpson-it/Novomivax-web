---
import type { Lang } from '../../i18n';
import { dict, langPath } from '../../i18n';
import PageHero from './PageHero.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dict(lang);
const base = import.meta.env.BASE_URL;
---

<PageHero
  lang={lang}
  eyebrow={t.contact.hero.eyebrow}
  title={t.contact.hero.title}
  intro={t.contact.hero.intro}
/>

<section class="section">
  <div class="container contact-grid">
    <div class="contact-details reveal-on-scroll">
      <h2>{t.contact.details.heading}</h2>

      <div class="contact-block">
        <span class="contact-label">{t.contact.details.addressLabel}</span>
        <p class="contact-value">{t.contact.details.address}</p>
      </div>

      <div class="contact-block">
        <span class="contact-label">Email</span>
        <ul class="contact-email-list">
          {t.contact.details.emails.map((email) => (
            <li>
              <span class="contact-email-label">{email.label}</span>
              <a href={`mailto:${email.value}`} class="contact-email-value">{email.value}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="contact-block">
        <span class="contact-label">{t.contact.details.phoneLabel}</span>
        <a href={`tel:${t.contact.details.phone.replace(/\s/g, '')}`} class="contact-value contact-phone">
          {t.contact.details.phone}
        </a>
      </div>

      <a href={langPath(lang, 'pipeline/')} class="link-arrow contact-more">
        {t.common.learnMore}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14M13 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    <form class="contact-form reveal-on-scroll" method="POST" action={`mailto:${t.contact.details.emails[0].value}`}>
      <h2>{t.contact.form.heading}</h2>
      <div class="form-group">
        <label for="name">{t.contact.form.name}</label>
        <input type="text" id="name" name="name" class="form-input" required autocomplete="name" />
      </div>
      <div class="form-group">
        <label for="email">{t.contact.form.email}</label>
        <input type="email" id="email" name="email" class="form-input" required autocomplete="email" />
      </div>
      <div class="form-group">
        <label for="message">{t.contact.form.message}</label>
        <textarea id="message" name="message" class="form-input form-textarea" rows="5" required></textarea>
      </div>
      <button type="submit" class="btn btn-primary">{t.contact.form.submit}</button>
      <p class="form-note">{t.contact.form.note}</p>
    </form>
  </div>
</section>

<section class="section section--tight">
  <div class="container">
    <div class="map-placeholder reveal-on-scroll">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11z"/>
        <circle cx="12" cy="10" r="2.5"/>
      </svg>
      <div>
        <strong>{t.contact.details.address}</strong>
        <span>Hong Kong SAR</span>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: var(--space-16);
    align-items: start;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .contact-details h2 {
    margin-bottom: var(--space-2);
  }

  .contact-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    border-top: 1px solid var(--color-gray-50);
    padding-top: var(--space-6);
  }

  .contact-label {
    font-size: 0.72rem;
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-gray-500);
  }

  .contact-value {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    color: var(--color-heading);
    margin: 0;
  }

  .contact-phone {
    color: var(--color-primary);
  }

  .contact-email-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .contact-email-list li {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .contact-email-label {
    font-size: var(--text-xs);
    color: var(--color-gray-600);
  }

  .contact-email-value {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    word-break: break-all;
  }

  .contact-more {
    margin-top: var(--space-4);
  }

  .contact-form {
    background-color: var(--color-off-white);
    border: 1px solid var(--color-gray-50);
    border-radius: var(--radius-xl);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .contact-form h2 {
    margin-bottom: var(--space-2);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .form-group label {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-body);
  }

  .form-input {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-gray-100);
    border-radius: var(--radius-md);
    background-color: var(--color-white);
    color: var(--color-body);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .form-input::placeholder {
    color: var(--color-gray-500);
  }

  .form-input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(49, 127, 179, 0.15);
  }

  .form-textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-note {
    font-size: var(--text-xs);
    color: var(--color-gray-500);
    margin: 0;
  }

  .map-placeholder {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-6) var(--space-8);
    border: 1px dashed var(--color-gray-100);
    border-radius: var(--radius-lg);
    background: var(--color-off-white);
    max-width: 640px;
  }

  .map-placeholder svg {
    width: 32px;
    height: 32px;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .map-placeholder strong {
    display: block;
    font-family: var(--font-display);
    color: var(--color-heading);
    margin-bottom: 2px;
  }

  .map-placeholder span {
    font-size: var(--text-xs);
    color: var(--color-gray-500);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: var(--space-12);
    }
  }
</style>
