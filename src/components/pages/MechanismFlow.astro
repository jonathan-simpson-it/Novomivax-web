---
export interface DiagramStep {
  title: string;
  text: string;
}

interface Props {
  steps: readonly DiagramStep[];
  variant: 'bstcv' | 'antcv';
}

const { steps, variant } = Astro.props;

const icons = {
  bstcv: [
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M7 12h10"/></svg>',
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v4M12 17v4M3 12h4M17 12h4"/><circle cx="12" cy="12" r="3.5"/><circle cx="12" cy="12" r="7"/></svg>',
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12l5 5L20 7"/></svg>',
  ],
  antcv: [
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3h10M7 3v18M7 8h6a3 3 0 0 1 0 6H7M17 3v7"/><circle cx="14" cy="16" r="3"/><circle cx="14" cy="16" r="0.6" fill="currentColor"/></svg>',
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"/><path d="M17 14l3 3-3 3"/></svg>',
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"/><path d="M12 8v5M12 15.5v.5"/></svg>',
  ],
} as const;

const variantClass = variant === 'bstcv' ? 'flow--bstcv' : 'flow--antcv';
---

<div class:list={['mechanism-flow', variantClass]}>
  {steps.map((step, i) => (
    <>
      {i > 0 && (
        <div class="flow-connector" aria-hidden="true">
          <span class="flow-dot"></span>
          <span class="flow-dot flow-dot--2"></span>
        </div>
      )}
      <div class="flow-node">
        <span class="flow-node-icon" set:html={icons[variant][i]}></span>
        <span class="flow-node-index">{i + 1}</span>
        <strong class="flow-node-title">{step.title}</strong>
        <span class="flow-node-text">{step.text}</span>
      </div>
    </>
  ))}
</div>

<style>
  .mechanism-flow {
    display: grid;
    grid-template-columns: 1fr 64px 1fr 64px 1fr;
    align-items: stretch;
    gap: 0;
  }

  .flow-node {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-align: center;
    padding: var(--space-8) var(--space-5);
    border: 1px solid var(--color-gray-50);
    border-radius: var(--radius-lg);
    background-color: var(--color-white);
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--transition-base),
      box-shadow var(--transition-base),
      border-color var(--transition-base);
  }

  .flow-node:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-primary-light);
  }

  .flow-node-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: var(--radius-lg);
    color: var(--color-white);
    animation: icon-breathe 3s ease-in-out infinite;
  }

  .flow--bstcv .flow-node-icon {
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
  }

  .flow--antcv .flow-node-icon {
    background: linear-gradient(135deg, #2e7d6b, #1f5c4e);
  }

  .flow-node-icon svg {
    width: 26px;
    height: 26px;
  }

  .flow-node-index {
    position: absolute;
    top: 10px;
    right: 14px;
    font-size: 0.72rem;
    font-weight: var(--weight-bold);
    color: var(--color-gray-500);
    letter-spacing: 0.06em;
  }

  .flow-node-title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    color: var(--color-heading);
    max-width: 16ch;
  }

  .flow-node-text {
    font-size: var(--text-xs);
    color: var(--color-body-secondary);
    line-height: var(--leading-snug);
    max-width: 24ch;
  }

  .flow-connector {
    position: relative;
    align-self: center;
    height: 2px;
    border-radius: 2px;
    background-image: linear-gradient(90deg, var(--color-primary-light) 50%, transparent 50%);
    background-size: 12px 2px;
    animation: flow-dash 1.2s linear infinite;
    opacity: 0.8;
  }

  @keyframes flow-dash {
    to { background-position: 12px 0; }
  }

  .flow-dot {
    position: absolute;
    top: 50%;
    left: -6px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-primary);
    transform: translateY(-50%);
    animation: dot-travel 3.2s ease-in-out infinite;
    opacity: 0;
  }

  .flow-dot--2 {
    animation-delay: 1.6s;
  }

  @keyframes dot-travel {
    0% { left: -8px; opacity: 0; }
    12% { opacity: 1; }
    88% { opacity: 1; }
    100% { left: calc(100% - 2px); opacity: 0; }
  }

  @keyframes icon-breathe {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow-connector,
    .flow-dot,
    .flow-node-icon {
      animation: none;
    }

    .flow-dot {
      opacity: 0.6;
      left: 50%;
    }
  }

  @media (max-width: 900px) {
    .mechanism-flow {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .flow-connector {
      height: 40px;
      width: 2px;
      margin: 0 auto;
      background-image: linear-gradient(180deg, var(--color-primary-light) 50%, transparent 50%);
      background-size: 2px 12px;
      animation-name: flow-dash-vertical;
    }

    @keyframes flow-dash-vertical {
      to { background-position: 0 12px; }
    }

    .flow-dot {
      top: -6px;
      left: 50%;
      transform: translateX(-50%);
      animation-name: dot-travel-vertical;
    }

    @keyframes dot-travel-vertical {
      0% { top: -8px; opacity: 0; }
      12% { opacity: 1; }
      88% { opacity: 1; }
      100% { top: calc(100% - 2px); opacity: 0; }
    }
  }
</style>
