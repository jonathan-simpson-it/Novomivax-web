---
export interface Props {
  heading: string;
  paragraph?: string;
  primary: { label: string; href: string };
  secondary?: { label: string; href: string };
}

const { heading, paragraph, primary, secondary } = Astro.props;
---

<section class="section-dark cta-band">
  <div class="cta-glow" aria-hidden="true"></div>
  <div class="cta-inner">
    <h2 class="reveal-on-scroll">{heading}</h2>
    {paragraph && <p class="reveal-on-scroll">{paragraph}</p>}
    <div class="cta-actions reveal-on-scroll">
      <a href={primary.href} class="btn btn-primary">{primary.label}</a>
      {secondary && <a href={secondary.href} class="btn btn-secondary">{secondary.label}</a>}
    </div>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    overflow: hidden;
  }

  .cta-band .cta-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--section-pad) var(--content-padding);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
    position: relative;
    z-index: 2;
  }

  .cta-band h2 {
    max-width: 24ch;
    color: var(--color-white);
  }

  .cta-band p {
    color: var(--color-dark-muted);
    max-width: 52ch;
    margin: 0;
  }

  .cta-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }

  .cta-glow {
    position: absolute;
    width: 520px;
    height: 520px;
    border-radius: 50%;
    filter: blur(70px);
    background: rgba(49, 127, 179, 0.22);
    top: 50%;
    right: -140px;
    transform: translateY(-50%);
    pointer-events: none;
  }
</style>
