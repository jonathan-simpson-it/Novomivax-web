---
import type { Lang } from '../../i18n';
import { dict, langPath } from '../../i18n';
import PageHero from './PageHero.astro';
import MilestoneTimeline from './MilestoneTimeline.astro';
import CtaBand from './CtaBand.astro';
import SectionHead from './SectionHead.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dict(lang);
---

<PageHero
  lang={lang}
  eyebrow={t.about.hero.eyebrow}
  title={t.about.hero.title}
  intro={t.about.hero.intro}
  cta={[{ label: t.about.hero.cta, href: '#mission-vision' }]}
/>

<!-- Company profile -->
<section class="section">
  <div class="container profile-grid">
    <div class="profile-text reveal-on-scroll">
      <SectionHead eyebrow={t.about.profile.eyebrow} heading={t.about.profile.heading} />
      {t.about.profile.paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
    <dl class="profile-facts reveal-on-scroll">
      {t.about.profile.facts.map((fact) => (
        <div class="profile-fact">
          <dt class="profile-fact-label">{fact.label}</dt>
          <dd class="profile-fact-value">{fact.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<!-- Mission & Vision -->
<section id="mission-vision" class="section section-alt">
  <div class="container mission-vision-grid">
    <article class="mission-card reveal-on-scroll">
      <p class="eyebrow">{t.about.missionVision.mission.eyebrow}</p>
      <h2>{t.about.missionVision.mission.heading}</h2>
      <p>{t.about.missionVision.mission.text}</p>
    </article>
    <article class="mission-card mission-card--dark reveal-on-scroll">
      <p class="eyebrow eyebrow--light">{t.about.missionVision.vision.eyebrow}</p>
      <h2>{t.about.missionVision.vision.heading}</h2>
      <p>{t.about.missionVision.vision.text}</p>
    </article>
  </div>
</section>

<!-- Timeline -->
<section class="section">
  <div class="container">
    <div class="section-head reveal-on-scroll">
      <p class="eyebrow">{t.about.timeline.eyebrow}</p>
      <h2>{t.about.timeline.heading}</h2>
    </div>
    <div class="reveal-on-scroll">
      <MilestoneTimeline items={t.about.timeline.items} />
    </div>
  </div>
</section>

<CtaBand
  heading={t.about.ctaBand.heading}
  primary={{ label: t.about.ctaBand.primary, href: langPath(lang, 'technology/') }}
  secondary={{ label: t.about.ctaBand.secondary, href: langPath(lang, 'contact/') }}
/>

<style>
  .profile-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: var(--space-16);
    align-items: start;
  }

  .profile-text p {
    color: var(--color-body-secondary);
    max-width: 52ch;
  }

  .profile-facts {
    margin: 0;
    border-top: 1px solid var(--color-gray-50);
  }

  .profile-fact {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--color-gray-50);
  }

  .profile-fact-label {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gray-500);
    font-weight: var(--weight-semibold);
  }

  .profile-fact-value {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--color-heading);
    font-weight: var(--weight-semibold);
  }

  .mission-vision-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  .mission-card {
    border: 1px solid var(--color-gray-50);
    background-color: var(--color-white);
    border-radius: var(--radius-xl);
    padding: var(--space-10);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .mission-card h2 {
    max-width: 20ch;
  }

  .mission-card p:last-child {
    color: var(--color-body-secondary);
    margin: 0;
    max-width: 40ch;
  }

  .mission-card--dark {
    background-color: var(--color-dark-bg);
    border-color: var(--color-dark-bg);
  }

  .mission-card--dark h2 {
    color: var(--color-white);
  }

  .mission-card--dark p:last-child {
    color: var(--color-dark-muted);
  }

  @media (max-width: 900px) {
    .profile-grid,
    .mission-vision-grid {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }
  }
</style>
