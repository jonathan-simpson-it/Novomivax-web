---
export interface RoadmapPhase {
  period: string;
  items: readonly string[];
}

interface Props {
  phases: readonly RoadmapPhase[];
}

const { phases } = Astro.props;
---

<ol class="roadmap">
  {phases.map((phase, i) => (
    <li class:list={['roadmap-phase', i === phases.length - 1 && 'roadmap-phase--final']}>
      <span class="roadmap-dot" aria-hidden="true"></span>
      <div class="roadmap-body">
        <span class="roadmap-period">{phase.period}</span>
        <ul class="roadmap-items">
          {phase.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </li>
  ))}
</ol>

<style>
  .roadmap {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
    position: relative;
  }

  .roadmap::before {
    content: '';
    position: absolute;
    top: 7px;
    left: 0;
    right: 0;
    height: 2px;
    border-radius: 1px;
    background: linear-gradient(90deg, var(--color-primary-light), rgba(74, 154, 212, 0.15));
  }

  .roadmap-phase {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .roadmap-dot {
    position: relative;
    z-index: 1;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 3px solid var(--color-dark-bg);
    background-color: var(--color-primary-light);
    box-shadow: 0 0 0 2px var(--color-primary-light);
  }

  .roadmap-phase--final .roadmap-dot {
    animation: dot-pulse 2.4s ease-in-out infinite;
  }

  @keyframes dot-pulse {
    0%, 100% { box-shadow: 0 0 0 2px var(--color-primary-light), 0 0 0 0 rgba(74, 154, 212, 0.4); }
    50% { box-shadow: 0 0 0 2px var(--color-primary-light), 0 0 0 8px rgba(74, 154, 212, 0.15); }
  }

  .roadmap-period {
    display: inline-block;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    color: var(--color-primary-light);
    margin-bottom: var(--space-3);
  }

  .roadmap-items {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .roadmap-items li {
    position: relative;
    padding-left: var(--space-5);
    color: var(--color-dark-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .roadmap-items li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-primary-light);
    opacity: 0.7;
  }

  @media (max-width: 900px) {
    .roadmap {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .roadmap::before {
      top: 7px;
      bottom: 0;
      left: 7px;
      width: 2px;
      height: auto;
      right: auto;
      background: linear-gradient(180deg, var(--color-primary-light), rgba(74, 154, 212, 0.15));
    }

    .roadmap-phase {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-4);
      padding-left: var(--space-6);
    }

    .roadmap-dot {
      position: absolute;
      left: 0;
    }
  }
</style>
