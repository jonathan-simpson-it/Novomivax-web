---
import type { Lang } from '../../i18n';
import { dict } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dict(lang);
const base = import.meta.env.BASE_URL;
const stages = t.home.science.stages;
---

<section id="science" class="section science-section">
  <div class="container">
    <div class="section-head reveal-on-scroll">
      <p class="eyebrow">{t.home.science.eyebrow}</p>
      <h2>{t.home.science.heading}</h2>
      <p>{t.home.science.intro}</p>
    </div>

    <!-- Stage 01: Problem -->
    <div class="stage-panel stage-panel--alt reveal-on-scroll">
      <div class="stage-content">
        <span class="stage-number">01</span>
        <h3>{stages[0].heading}</h3>
        <p>{stages[0].body}</p>
        <ul class="stage-list">
          {stages[0].problems.map((problem) => (
            <li>{problem}</li>
          ))}
        </ul>
        <p class="stage-note">{stages[0].note}</p>
      </div>
      <div class="stage-visual">
        <div class="diagram-problem">
          <div class="diagram-split">
            <div class="diagram-side diagram-side--blocked">
              <div class="diagram-side-label">{stages[0].diagram.current}</div>
              <div class="tumour tumour--cold">
                <div class="tumour-inner"></div>
              </div>
              <div class="diagram-status">{stages[0].diagram.blocked}</div>
              <div class="barrier-labels">
                {stages[0].diagram.barriers.map((barrier) => (
                  <div class="barrier-item">
                    <span class="barrier-dot"></span>
                    <span class="barrier-text">{barrier}</span>
                  </div>
                ))}
              </div>
            </div>
            <div class="diagram-vs" aria-hidden="true">vs</div>
            <div class="diagram-side diagram-side--target">
              <div class="diagram-side-label">{stages[0].diagram.needed}</div>
              <div class="tumour tumour--hot">
                <div class="tumour-inner"></div>
                <div class="target-ring"></div>
                <div class="target-dot"></div>
              </div>
              <div class="diagram-status diagram-status--active">{stages[0].diagram.target}</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Stage 02: Solution -->
    <div class="stage-panel reveal-on-scroll">
      <div class="stage-visual">
        <div class="diagram-solution">
          <div class="solution-center">
            <span class="solution-center-text">NOVOMI<br />VAX</span>
          </div>
          <div class="solution-cards">
            {stages[1].diagram.cards.map((card) => (
              <div class="solution-card">
                <div class="solution-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"/>
                    <circle cx="12" cy="12" r="6"/>
                    <circle cx="12" cy="12" r="2"/>
                  </svg>
                </div>
                <strong>{card.title}</strong>
                <span>{card.text}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
      <div class="stage-content">
        <span class="stage-number">02</span>
        <h3>{stages[1].heading}</h3>
        <p>{stages[1].body}</p>
        <ul class="stage-list">
          {stages[1].points.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Stage 03: Mechanism video -->
    <div class="stage-panel stage-panel--alt reveal-on-scroll">
      <div class="stage-content">
        <span class="stage-number">03</span>
        <h3>{stages[2].heading}</h3>
        <p>{stages[2].body}</p>
        <ol class="stage-steps">
          {stages[2].steps.map((step) => (
            <li>{step}</li>
          ))}
        </ol>
      </div>
      <div class="stage-visual">
        <div class="video-wrapper">
          <video
            autoplay
            muted
            loop
            playsinline
            poster={base + 'videos/how-it-works-poster.jpg'}
            preload="none"
            class="how-video"
          >
            <source src={base + 'videos/how-it-works.webm'} type="video/webm" />
            <source src={base + 'videos/how-it-works.mp4'} type="video/mp4" />
          </video>
        </div>
      </div>
    </div>

    <!-- Stage 04: Cascade -->
    <div class="stage-panel reveal-on-scroll">
      <div class="stage-content">
        <span class="stage-number">04</span>
        <h3>{stages[3].heading}</h3>
        <p>{stages[3].body}</p>
      </div>
      <div class="stage-visual stage-visual--full">
        <div class="diagram-cascade">
          {stages[3].cascadeTitles.map((title, i) => (
            <>
              {i > 0 && (
                <div class="cascade-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 12h14M13 5l7 7-7 7"/>
                  </svg>
                </div>
              )}
              <div class="cascade-node">
                <span class="cascade-number">{i + 1}</span>
                <strong class="cascade-title">{title}</strong>
                <span class="cascade-desc">{stages[3].cascade[i]}</span>
              </div>
            </>
          ))}
        </div>
        <p class="stage-note cascade-note">{stages[3].note}</p>
      </div>
    </div>

    <p class="medical-disclaimer reveal-on-scroll">{t.home.science.disclaimer}</p>
  </div>
</section>

<style>
  .science-section {
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }

  .stage-panel {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: center;
    padding: var(--space-16) 0;
    border-bottom: 1px solid var(--color-gray-50);
  }

  .stage-panel:last-of-type {
    border-bottom: none;
  }

  .stage-panel--alt {
    padding: var(--space-16) var(--space-8);
    margin: 0 calc(-1 * var(--space-8));
    border-radius: var(--radius-xl);
    background-color: var(--color-off-white);
    border-bottom: none;
  }

  .stage-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: var(--color-primary);
    color: var(--color-white);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    margin-bottom: var(--space-4);
  }

  .stage-content h3 {
    margin-bottom: var(--space-4);
  }

  .stage-content p {
    color: var(--color-body-secondary);
    margin-bottom: var(--space-4);
  }

  .stage-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .stage-list li {
    position: relative;
    padding-left: var(--space-6);
    color: var(--color-body-secondary);
    font-size: var(--text-sm);
  }

  .stage-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: var(--space-2);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-primary);
  }

  .stage-steps {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    counter-reset: step-counter;
  }

  .stage-steps li {
    position: relative;
    padding-left: var(--space-10);
    color: var(--color-body-secondary);
    font-size: var(--text-sm);
    counter-increment: step-counter;
  }

  .stage-steps li::before {
    content: counter(step-counter);
    position: absolute;
    left: 0;
    top: 0;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background-color: var(--color-primary-light);
    color: var(--color-white);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stage-note {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-primary);
    margin-top: var(--space-4);
  }

  .stage-visual--full {
    grid-column: 1 / -1;
  }

  /* === Stage 1 Diagram === */
  .diagram-split {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-6);
    align-items: stretch;
  }

  .diagram-vs {
    align-self: center;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-gray-600);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .diagram-side {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-8) var(--space-4);
    border-radius: var(--radius-lg);
  }

  .diagram-side--blocked {
    background-color: rgba(13, 21, 32, 0.05);
  }

  .diagram-side--target {
    background-color: rgba(49, 127, 179, 0.08);
    border: 1px solid rgba(49, 127, 179, 0.2);
  }

  .diagram-side-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-gray-600);
  }

  .tumour {
    position: relative;
    width: 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tumour-inner {
    position: relative;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    overflow: hidden;
  }

  .tumour--cold .tumour-inner {
    background: radial-gradient(circle at 40% 40%, #8ba4b8, #4a6a82);
  }

  .tumour--hot .tumour-inner {
    background: radial-gradient(circle at 40% 40%, #f0a06a, #c85a3a);
  }

  .tumour--cold .tumour-inner::before,
  .tumour--cold .tumour-inner::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 24px;
    height: 2px;
    background-color: rgba(200, 70, 70, 0.6);
    border-radius: 1px;
    animation: cold-cross 3s ease-in-out infinite;
  }

  .tumour--cold .tumour-inner::before {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .tumour--cold .tumour-inner::after {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  .target-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 64px;
    height: 64px;
    border: 2px dashed var(--color-primary-light);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    animation: pulse-ring 3s ease-in-out infinite;
    box-shadow: 0 0 8px rgba(49, 127, 179, 0.15);
  }

  .target-dot {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-primary);
    transform: translate(-50%, -50%);
    box-shadow: 0 0 6px rgba(49, 127, 179, 0.5);
  }

  @keyframes cold-cross {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 0.7; }
  }

  @keyframes pulse-ring {
    0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.6; box-shadow: 0 0 8px rgba(49, 127, 179, 0.15); }
    50% { transform: translate(-50%, -50%) scale(1.18); opacity: 1; box-shadow: 0 0 16px rgba(49, 127, 179, 0.35); }
  }

  .diagram-status {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-gray-600);
  }

  .diagram-status--active {
    color: var(--color-primary-dark);
  }

  .barrier-labels {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    width: 100%;
    margin-top: var(--space-3);
  }

  .barrier-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .barrier-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-gray-500);
    flex-shrink: 0;
  }

  .barrier-text {
    font-size: var(--text-xs);
    color: var(--color-gray-600);
    line-height: var(--leading-snug);
  }

  /* === Stage 2 Diagram === */
  .diagram-solution {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
    padding: var(--space-4) 0;
  }

  .diagram-solution::before {
    content: '';
    position: absolute;
    top: 44px;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: linear-gradient(to bottom, var(--color-primary-light), rgba(74, 154, 212, 0.15));
    transform: translateX(-50%);
    pointer-events: none;
  }

  .solution-center {
    position: relative;
    width: 88px;
    height: 88px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-md);
    z-index: 2;
    animation: breathe-center 2.5s ease-in-out infinite;
  }

  .solution-center::after {
    content: '';
    position: absolute;
    width: 104px;
    height: 104px;
    border-radius: 50%;
    border: 1px solid rgba(49, 127, 179, 0.35);
    animation: ripple-glow 2.5s ease-in-out infinite;
  }

  .solution-center-text {
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: var(--weight-bold);
    color: var(--color-white);
    text-align: center;
    line-height: 1.3;
    z-index: 1;
  }

  @keyframes breathe-center {
    0%, 100% { transform: scale(1); box-shadow: var(--shadow-md); }
    50% { transform: scale(1.04); box-shadow: 0 6px 24px rgba(49, 127, 179, 0.25); }
  }

  @keyframes ripple-glow {
    0%, 100% { transform: scale(1); opacity: 0.45; }
    50% { transform: scale(1.1); opacity: 0.75; }
  }

  .solution-cards {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    width: 100%;
  }

  .solution-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-align: center;
    padding: 20px var(--space-4);
    border: 1px solid var(--color-gray-50);
    border-radius: var(--radius-lg);
    background-color: var(--color-white);
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--transition-base),
      box-shadow var(--transition-base),
      border-color var(--transition-base);
  }

  .solution-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-primary-light);
  }

  .solution-card strong {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    color: var(--color-heading);
  }

  .solution-card span {
    font-size: var(--text-xs);
    color: var(--color-body-secondary);
    line-height: var(--leading-snug);
  }

  .solution-icon {
    width: 30px;
    height: 30px;
    color: var(--color-primary);
  }

  /* === Stage 3 Video === */
  .video-wrapper {
    position: relative;
    width: 100%;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    background-color: var(--color-dark-bg);
  }

  .how-video {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  /* === Stage 4 Diagram === */
  .diagram-cascade {
    display: grid;
    grid-template-columns: 1fr 30px 1fr 30px 1fr 30px 1fr;
    align-items: start;
    margin: var(--space-8) 0;
  }

  .cascade-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-align: center;
    padding: var(--space-6) var(--space-3);
    border: 1px solid var(--color-gray-50);
    border-radius: var(--radius-lg);
    background-color: var(--color-off-white);
    transition:
      transform var(--transition-base),
      box-shadow var(--transition-base),
      border-color var(--transition-base),
      background-color var(--transition-base);
  }

  .cascade-node:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-primary-light);
    background-color: var(--color-white);
  }

  .cascade-number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: var(--color-primary);
    color: var(--color-white);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    transition: background-color var(--transition-base);
  }

  .cascade-title {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    color: var(--color-heading);
  }

  .cascade-desc {
    font-size: var(--text-xs);
    color: var(--color-body-secondary);
    line-height: var(--leading-snug);
    max-width: 20ch;
  }

  .cascade-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: var(--space-12);
  }

  .cascade-arrow svg {
    width: 18px;
    height: 18px;
    color: var(--color-primary-light);
    animation: arrow-nudge 2s ease-in-out infinite;
  }

  @keyframes arrow-nudge {
    0%, 100% { transform: translateX(0); opacity: 0.55; }
    50% { transform: translateX(3px); opacity: 1; }
  }

  .cascade-note {
    text-align: center;
    margin-top: var(--space-4);
  }

  /* === Disclaimer === */
  .medical-disclaimer {
    font-size: var(--text-xs);
    color: var(--color-gray-500);
    text-align: center;
    margin-top: var(--space-16);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-gray-50);
  }

  /* === Responsive === */
  @media (max-width: 900px) {
    .stage-panel {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .stage-panel--alt {
      margin: 0;
    }

    .diagram-split {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .diagram-vs {
      text-align: center;
    }

    .diagram-cascade {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }

    .cascade-arrow {
      padding-top: 0;
      justify-content: center;
    }

    .cascade-arrow svg {
      transform: rotate(90deg);
    }

    .solution-cards {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .stage-panel {
      padding-top: var(--space-10);
      padding-bottom: var(--space-10);
    }

    .stage-panel--alt {
      padding: var(--space-8) var(--space-4);
    }

    .tumour {
      width: 60px;
      height: 60px;
    }

    .tumour-inner {
      width: 48px;
      height: 48px;
    }

    .target-ring {
      width: 48px;
      height: 48px;
    }
  }
</style>
