---
import '../styles/global.css';
import HeaderNav from '../components/header/HeaderNav.astro';
import SiteFooter from '../components/footer/SiteFooter.astro';
import { dict, type Lang, langPath, PAGE_ROUTES } from '../i18n';

export interface Props {
  lang?: Lang;
  page?: 'home' | 'about' | 'technology' | 'pipeline' | 'clinical' | 'team' | 'contact';
}

const { lang = 'en', page } = Astro.props;
const t = dict(lang);
const base = import.meta.env.BASE_URL;
const site = import.meta.env.SITE;

const pageMeta = page ? t.pages[page] : { title: t.meta.defaultTitle, description: t.meta.defaultDescription };
const htmlLang = lang === 'zh' ? 'zh-CN' : 'en';
const title = page ? `${pageMeta.title}` : t.meta.defaultTitle;
const description = page ? pageMeta.description : t.meta.defaultDescription;

const route = PAGE_ROUTES.find((r) => r.title === page);
const canonicalPath = route ? `${base}${lang === 'zh' ? 'zh/' : ''}${route.path}` : base;
const alternatePaths = {
  en: `${base}${route?.path ?? ''}`,
  zh: `${base}zh/${route?.path ?? ''}`,
};
---

<!DOCTYPE html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={site + canonicalPath} />
    <link rel="alternate" hreflang="en" href={site + alternatePaths.en} />
    <link rel="alternate" hreflang="zh-CN" href={site + alternatePaths.zh} />
    <link rel="alternate" hreflang="x-default" href={site + alternatePaths.en} />
    <link rel="icon" type="image/png" href={base + 'images/Novomi-logo.png'} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={base + 'fonts/raleway-latin.woff2'} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.meta.siteName} />
    <meta property="og:title" content={page ? `${pageMeta.title}` : t.meta.ogTitle} />
    <meta property="og:description" content={page ? description : t.meta.ogDescription} />
    <meta property="og:url" content={site + canonicalPath} />
    <meta name="twitter:card" content="summary" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'NOVOMI VAX',
      legalName: 'NOVOMI VAX Limited',
      url: site + base,
      email: 'enhe00000@connect.hku.hk',
      telephone: '+85284970818',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'L3-61, Lab Block, 21 Sassoon Road, Pokfulam',
        addressLocality: 'Hong Kong',
        addressCountry: 'HK',
      },
      foundingDate: '2025-10-28',
      description: t.meta.ogDescription,
    })} />
  </head>
  <body>
    <script is:inline define:vars={{ base }}>
      // Progressive enhancement gate + language auto-detect (no manual override = browser rules)
      document.documentElement.classList.add('js');
      (function () {
        try {
          var override = localStorage.getItem('novomi_lang');
          if (override === 'zh' || override === 'en') return;
          var lang = (navigator.language || '').toLowerCase();
          var isChinese =
            lang.indexOf('zh') === 0 ||
            Intl.DateTimeFormat().resolvedOptions().timeZone === 'Asia/Shanghai';
          var zhRoot = base + 'zh/';
          var here = window.location.pathname;
          if (isChinese && here.indexOf(zhRoot) === -1) {
            var rel = here.replace(base, '');
            window.location.replace(zhRoot + rel);
          }
        } catch (e) {}
      })();
    </script>
    <a class="skip-link" href="#main">Skip to content</a>
    <HeaderNav lang={lang} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter lang={lang} />
    <script is:inline>
      document.addEventListener('DOMContentLoaded', function () {
        var restoreScroll = null;
        try {
          var stored = sessionStorage.getItem('novomi_scroll');
          if (stored !== null) {
            restoreScroll = parseInt(stored, 10);
            sessionStorage.removeItem('novomi_scroll');
          }
        } catch (e) {}

        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Language switch navigation: show everything instantly and restore the scroll position.
        if (restoreScroll !== null || reduce) {
          document.querySelectorAll('.reveal-on-scroll').forEach(function (el) {
            el.classList.add('is-visible');
          });
          if (restoreScroll !== null) {
            window.scrollTo(0, restoreScroll);
            window.addEventListener('load', function () {
              window.scrollTo(0, restoreScroll);
            });
          }
          return;
        }

        var pending = Array.from(document.querySelectorAll('.reveal-on-scroll'));
        var observer = new IntersectionObserver(
          function (entries) {
            for (var i = 0; i < entries.length; i++) {
              if (entries[i].isIntersecting) {
                entries[i].target.classList.add('is-visible');
                observer.unobserve(entries[i].target);
              }
            }
          },
          { threshold: 0.05, rootMargin: '0px 0px -30px 0px' }
        );
        pending.forEach(function (el) {
          observer.observe(el);
        });
        // Safety fallback: never leave content hidden (headless renders, print,
        // fast scrolls, or observers that fail to fire).
        setTimeout(function () {
          document.querySelectorAll('.reveal-on-scroll:not(.is-visible)').forEach(function (el) {
            el.classList.add('is-visible');
          });
        }, 1800);
      });
    </script>
  </body>
</html>
